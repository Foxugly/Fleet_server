# Fleet: Celery beat (collection schedule, apps/collect/intervals.py).
# Installed by the deploy (fleet-deploy-privileged.sh) from root's mirror.
[Unit]
Description=Fleet: Celery beat
After=network.target fleet-app-env-fetch.service postgresql.service redis-server.service fleet-app-celery.service
Requires=fleet-app-env-fetch.service

[Service]
Type=simple
User=fleet
Group=fleet
UMask=0027
WorkingDirectory=/srv/fleet/Fleet_server
EnvironmentFile=/run/fleet/.env
Environment="PYTHONUNBUFFERED=1"
# /run/fleet belongs to root (750 root:fleet): fleet can traverse it but not
# write there, and beat must write its schedule file. systemd creates a
# dedicated directory owned by the service, recreated at every start (a stale
# schedule is worse than none). Same model as billing-celery-beat.
RuntimeDirectory=fleet-app-beat
RuntimeDirectoryMode=0750
ExecStart=/srv/fleet/Fleet_server/.venv/bin/python -m celery -A config beat -l info \
    --schedule /run/fleet-app-beat/schedule
# Hardening (OPERATIONS.md §3.22). Never ProtectSystem=strict on an app unit.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
