# Fleet_server environment. Prod values come from SSM /fleet/prod -> /run/fleet/.env.
# STATE: required, DEV or PROD (no default: missing refuses to start). PROD requires
# SECRET_KEY, ALLOWED_HOSTS, REDIS_URL and CORS_ALLOWED_ORIGINS; DEBUG only applies in DEV. Without
# SECRET_KEY, DEV uses a random key per process.
STATE=DEV
DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=

# Database (SQLite when DB_ENGINE is empty)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# DB_CONN_MAX_AGE: default 0; the gunicorn unit sets 60, never Celery.
DB_CONN_MAX_AGE=

# Auth (JWT + mandatory TOTP)
FLEET_MFA_ENCRYPTION_KEY=
FLEET_MFA_LOCKOUT_SECONDS=
JWT_ACCESS_MINUTES=
JWT_REFRESH_DAYS=
# CORS_ALLOWED_ORIGINS: required in PROD (explicit origins, no "*").
CORS_ALLOWED_ORIGINS=
AUTH_REFRESH_COOKIE_NAME=
AUTH_REFRESH_COOKIE_SECURE=
THROTTLE_ANON=
THROTTLE_USER=
THROTTLE_LOGIN=
THROTTLE_LOGIN_USERNAME=
THROTTLE_MFA=
THROTTLE_MFA_USER=
THROTTLE_REFRESH=

# Redis (Celery default redis://127.0.0.1:6379/12). Required in PROD: it also
# backs the cache (throttle counters); unset (DEV only) = per-process LocMem cache.
REDIS_URL=

# Collectors
FLEET_GITHUB_READ_TOKEN=
FLEET_SENTRY_TOKEN=
FLEET_SENTRY_ORG=
FLEET_SENTRY_API=
FLEET_INVENTORY_PATH=

# Sentry
SENTRY_DSN=
SENTRY_ENABLE=
SENTRY_ENVIRONMENT=
# SENTRY_RELEASE: defaults to the RELEASE file at the repo root (CI writes it), else "dev".
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
