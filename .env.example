# Fleet_server environment. Prod values come from SSM /fleet/prod -> /run/fleet/.env.
STATE=
DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=

# Database (SQLite when DB_ENGINE is empty)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=

# Redis (default redis://127.0.0.1:6379/12)
REDIS_URL=

# Collectors
FLEET_GITHUB_READ_TOKEN=
FLEET_SENTRY_TOKEN=
FLEET_SENTRY_ORG=
FLEET_SENTRY_API=
FLEET_INVENTORY_PATH=

# Sentry
SENTRY_DSN=
SENTRY_ENABLE=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
